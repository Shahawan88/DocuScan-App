<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DocuScan PDF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1A1C1E"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scan documents or bulk import from gallery to create clean PDFs."
        android:textAlignment="center"
        android:textSize="15sp"
        android:textColor="#5F6368"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnScan"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Scan or Import Photos"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#1A73E8" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Ready to scan"
        android:textAlignment="center"
        android:textSize="14sp"
        android:textColor="#188038" />

</LinearLayout>
